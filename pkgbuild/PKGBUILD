pkgname=stilwandler
pkgver=0.3.0
pkgrel=1
pkgdesc='Rewrites a message in an absurdly exaggerated style, ready to paste'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-svg' 'libsecret' 'wl-clipboard')
makedepends=('gcc' 'make')
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/stilwandler "$pkgdir/usr/bin/stilwandler"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/stilwandler.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/stilwandler.svg"
  install -Dm644 "$startdir/stilwandler.desktop" "$pkgdir/usr/share/applications/stilwandler.desktop"
}
